# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb://localhost:27017/devopspulse
MONGO_URI_TEST=mongodb://127.0.0.1:27017/devopspulse_test

# Authentication
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Monitoring & Scheduler Settings (Optional with defaults)
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=10000
MAX_CONCURRENT_CHECKS=5
SLOW_RESPONSE_MS=2000
HEALTHCHECK_RETENTION_DAYS=30

# Rate Limiting (Optional with defaults; raised in test environment)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
CHECK_RATE_LIMIT_WINDOW_MS=60000
CHECK_RATE_LIMIT_MAX=6

# Alerting & Notifications (Optional with defaults)
# SMTP Configuration for Email Alerts (Leave empty if email alerts disabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DevOpsPulse Alerts" <alerts@example.com>

# 32-byte hex encryption key for webhook URLs and signing secrets (Required in production)
# Generate in PowerShell: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_ENCRYPTION_KEY=

# Notification Rate Limits & Anti-Flapping
NOTIFY_RATE_PER_HOUR=30
NOTIFY_COOLDOWN_MINUTES=5
