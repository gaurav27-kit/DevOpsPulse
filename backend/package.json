{
  "name": "devopspulse-backend",
  "version": "1.0.0",
  "description": "DevOpsPulse backend API - Application monitoring and incident management",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:api": "vitest run",
    "check:incidents": "node scripts/incidentFlowCheck.js",
    "check:analytics": "node scripts/analyticsCheck.js",
    "check:sockets": "node scripts/socketCheck.js",
    "seed:demo": "node scripts/seedDemoData.js",
    "check:alerting": "node ../scripts/alertingCheck.js",
    "rollups:backfill": "node ../scripts/backfillRollups.js",
    "check:slo-rollups": "node ../scripts/sloRollupCheck.js",
    "check:slo": "node scripts/sloCheck.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.4.0",
    "socket.io": "^4.8.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  }
}
